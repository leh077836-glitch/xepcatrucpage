{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node -e \"const fs=require('fs');fs.mkdirSync('vercel-public',{recursive:true});fs.writeFileSync('vercel-public/__pageops_build.txt','PageOps proxy deployment')\"",
  "outputDirectory": "vercel-public",
  "rewrites": [
    {
      "source": "/t/:path*",
      "destination": "https://pageops-lich-truc.leh077836.workers.dev/t/:path*"
    },
    {
      "source": "/saas/platform/rooms",
      "destination": "https://pageops-lich-truc.leh077836.workers.dev/saas/platform/rooms"
    },
    {
      "source": "/",
      "destination": "https://pageops-lich-truc.leh077836.workers.dev/"
    },
    {
      "source": "/:path*",
      "destination": "https://pageops-lich-truc.leh077836.workers.dev/:path*"
    }
  ]
}
